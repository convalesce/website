# Google Analytics 4 measurement id. Without it, GA is not loaded at all —
# so local dev and preview deploys stay out of your reporting.
# Add the real value in Vercel: Project → Settings → Environment Variables.
NEXT_PUBLIC_GA_ID=

# Contact form (see lib/contact.ts)
# Reached keylessly: Workload Identity Federation on Vercel, your own gcloud login locally
GCP_PROJECT_ID=convalesce-io
GCP_PROJECT_NUMBER=539705002913
GCP_SERVICE_ACCOUNT_EMAIL=website-contact@convalesce-io.iam.gserviceaccount.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfJ5eItAAAAAJmapa2RSczZL6sck27AHkyKlkOG
# the Workspace mailbox the service account sends as, and where messages go
CONTACT_MAIL_FROM=v.joshi@convalesce.io
CONTACT_MAIL_TO=support@convalesce.io
